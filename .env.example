# Set these as environment variables (shell, Docker, or your host's dashboard).
ENV=development
SECRET_KEY=change-me-to-64-random-hex-characters
# PostgreSQL. The database is created automatically if it does not exist and the user is allowed to create it.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/promise_keeper
# Tables are created/updated automatically on every start. Set to 0 to run `python -m app.manage migrate` yourself.
AUTO_MIGRATE=1
# Only needed if the web app is hosted on a different domain than the API:
# CORS_ORIGINS=https://yourname.github.io
